# Skopiuj ten plik jako .env i uzupełnij wartości.
# Plik .env jest ignorowany przez git — nie commituj go.

# URL serwera API — zmień przy rotacji lub migracji serwera (domyślnie: Azure).
EXPO_PUBLIC_API_URL=

# Klucz administracyjny API (uzyskaj od administratora backendu po rotacji).
EXPO_PUBLIC_ADMIN_KEY=
